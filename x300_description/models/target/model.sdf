<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="target">
    <static>true</static>
    <link name="link">
      <inertial>
        <mass>0.1</mass>
      </inertial>
      <visual name="visual">
        <geometry>
          <sphere>
            <radius>0.3</radius> <!-- Same radius -->
          </sphere>
        </geometry>
        <material>
          <ambient>1 0 0 1</ambient> <!-- Pure red -->
          <diffuse>1 0 0 1</diffuse>
          <specular>1 1 1 1</specular> <!-- High specular for shininess -->
          <emissive>0.5 0 0 0.3</emissive>
        </material>
      </visual>
    </link>
  </model>
</sdf>