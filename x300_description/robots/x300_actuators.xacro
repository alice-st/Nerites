      <origin xyz="0.81 0.25 0" rpy="0 0 0" />
    </xacro:thruster_module_first_order_basic_fcn_macro_x300>
     <xacro:thruster_module_first_order_basic_fcn_macro_x300
      namespace="${namespace}"
      thruster_id="8"
      mesh_filename="${front_thruster_horizontal}"
      dyn_time_constant="0.1"
      rotor_constant="0.000049"
      thrust_axis="0 1 0">
      <origin xyz="0.81 -0.25 0" rpy="0 0 0" />
    </xacro:thruster_module_first_order_basic_fcn_macro_x300>
    <xacro:thruster_module_first_order_basic_fcn_macro_x300
